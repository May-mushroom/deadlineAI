{
  "manifest_version": 3,
  "name": "Day Task Planner",
  "version": "0.1.0",
  "description": "Plan tasks for the week and distribute them across your days.",
  "action": {
    "default_title": "Open Day Task Planner"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": ["sidePanel", "storage"],
  "background": {
    "service_worker": "background.js"
  }
}
